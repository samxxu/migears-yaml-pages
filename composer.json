{
    "name": "migears/yaml-pages",
    "description": "Declarative YAML page definitions compiled to miGears template files",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": [
        "pages",
        "declarative",
        "yaml",
        "template",
        "codegen",
        "migears"
    ],
    "require": {
        "php": "^8.1",
        "ext-yaml": "*",
        "migears/pages": "^2.0"
    },
    "require-dev": {
        "migears/template": "^2.0",
        "phpunit/phpunit": "^10"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../migears-pages"
        },
        {
            "type": "path",
            "url": "../migears-template"
        }
    ],
    "autoload": {
        "psr-4": {
            "MiGears\\YamlPages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\YamlPages\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
